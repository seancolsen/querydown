{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // These mirror the aliases in vite.config.ts.
      "querydown-js": ["./wasm/querydown_js.d.ts"],
      "querydown-js/*": ["./wasm/*"],
      "querydown-codemirror": ["../bindings/codemirror/src/index.ts"],
      // The CodeMirror package lives outside of this directory, so point its imports at our copy
      // of these libraries.
      "@codemirror/*": ["./node_modules/@codemirror/*"],
      "@lezer/*": ["./node_modules/@lezer/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["wasm", "build", "node_modules"]
}
