{
  "name": "querydown-codemirror",
  "version": "0.0.1",
  "description": "CodeMirror 6 language support (syntax highlighting and autocompletion) for Querydown",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/seancolsen/querydown"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "build:wasm": "wasm-pack build ../js --dev --target web --out-dir ../codemirror/test/wasm",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots=all",
    "test:visual:serve": "vite --config test/vite.config.ts"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
